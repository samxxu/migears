{
    "name": "migears/starter-minimal-site",
    "type": "project",
    "description": "A minimal miGears site: file routing, a native PHP template, a logger, and a development error page.",
    "license": "MIT",
    "repositories": [
        {
            "type": "path",
            "url": ".modules/migears-web",
            "options": {
                "symlink": true
            }
        },
        {
            "type": "path",
            "url": ".modules/migears-template",
            "options": {
                "symlink": true
            }
        },
        {
            "type": "path",
            "url": ".modules/migears-log",
            "options": {
                "symlink": true
            }
        },
        {
            "type": "path",
            "url": ".modules/migears-debug",
            "options": {
                "symlink": true
            }
        },
        {
            "type": "path",
            "url": ".modules/migears-http-exceptions",
            "options": {
                "symlink": true
            }
        }
    ],
    "require": {
        "php": "^8.1",
        "migears/web": "^2.3",
        "migears/template": "^2.3",
        "migears/log": "^2.3",
        "migears/debug": "^2.3",
        "migears/http-exceptions": "^2.3"
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        }
    },
    "config": {
        "sort-packages": true
    }
}
